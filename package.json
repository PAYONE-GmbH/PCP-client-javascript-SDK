{
  "name": "pcp-client-javascript-sdk",
  "version": "1.4.0",
  "description": "PAYONE Commerce Platform Client JavaScript SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist/**/*"],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:demo": "cd demo && npm install && npm run build",
    "start:demo": "cd demo && npm start",
    "prepublishOnly": "npm run build",
    "prepare": "lefthook install",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "format:check": "biome format",
    "format:write": "biome format --fix",
    "prepack": "npm run lint && npm run prepublishOnly",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -r 0",
    "version": "./version.sh"
  },
  "keywords": ["payone", "client", "typescript", "javascript", "sdk"],
  "license": "MIT",
  "author": "PAYONE-GmbH",
  "homepage": "https://github.com/PAYONE-GmbH/PCP-client-javascript-SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/PAYONE-GmbH/PCP-client-javascript-SDK.git"
  },
  "dependencies": {
    "@types/applepayjs": "14.0.9",
    "@types/googlepay": "0.7.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-angular": "9.4.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
