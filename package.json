{
  "name": "pcp-client-javascript-sdk",
  "version": "1.4.0",
  "description": "PAYONE Commerce Platform Client JavaScript SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "build:demo": "cd demo && npm install && npm run build",
    "start:demo": "cd demo && npm start",
    "prepublishOnly": "npm run build",
    "prepare": "lefthook install",
    "lint": "biome check",
    "prepack": "npm run lint && npm run prepublishOnly",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "version": "./version.sh"
  },
  "keywords": [
    "payone",
    "client",
    "typescript",
    "javascript",
    "sdk"
  ],
  "license": "MIT",
  "author": "PAYONE-GmbH",
  "homepage": "https://github.com/PAYONE-GmbH/PCP-client-javascript-SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/PAYONE-GmbH/PCP-client-javascript-SDK.git"
  },
  "dependencies": {
    "@types/applepayjs": "14.0.9",
    "@types/googlepay": "^0.7.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.0.12",
    "@vitest/coverage-v8": "3.2.4",
    "conventional-changelog-cli": "5.0.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "lefthook": "1.12.1",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
