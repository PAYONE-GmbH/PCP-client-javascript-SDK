{
  "compilerOptions": {
    "target": "ES6",
    "module": "NodeNext",
    "types": ["node"],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "sourceMap": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true
  },
  "include": ["src"],
  "exclude": ["**/__tests__/*"]
}
