# Public client configuration shared by Standard and Express Checkout.
# Copy into .env.local; URL parameters can override these values at runtime.
# Payments use processPaymentCallback -> POST <backendUrl>/commerce-cases, not a process-payment URL.
VITE_BACKEND_BASE_URL=https://api.example/api/
# Existing merchant-validation endpoint. No certificates/private keys belong in VITE_ values.
VITE_VALIDATE_MERCHANT_URL=https://shop.example/validate-merchant
