# Browser-accessible merchant backend, including its API prefix.
# PAYONE credentials, merchant selection and test/live mode belong on that server.
VITE_BACKEND_BASE_URL=http://localhost:3009/api/

# Initial shipping option: standard or express. URL ?shipping=... overrides this.
VITE_SHIPPING_OPTION=standard

# SDK Checkout only (/sdk.html). Public, fixed PAYONE sandbox SDK identifiers.
# These are NOT the PAYONE merchantId used by the backend API wrapper.
VITE_PAYPAL_CLIENT_ID=AUn5n-4qxBUkdzQBv6f8yd8F4AWdEvV6nLzbAifDILhKGCjOS62qQLiKbUbpIKH_O2Z3OL8CvX7ucZfh
VITE_PAYPAL_MERCHANT_ID=3QK84QGGJE5HW
# capture => requiresApproval=false (SALE); authorize => true (capture later server-side).
VITE_PAYPAL_INTENT=capture
VITE_PAYPAL_LOCALE=de_DE
