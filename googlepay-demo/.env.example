# Demo configuration template: copy to .env.local and fill in public merchant/backend settings.
# Public browser settings. Never add PAYONE credentials to a VITE_ variable.
# All settings below are required except GOOGLE_MERCHANT_ID in TEST. No URL overrides/defaults.
# Merchant backend facade ending before /commerce-cases (including any merchant prefix):
VITE_BACKEND_BASE_URL=https://backend.example/pcp/v1/your-merchant-id/
VITE_GOOGLE_ENVIRONMENT=TEST
# PAYONE merchant ID, commonly P1_XXXXX_YYYYYYY:
VITE_GOOGLE_GATEWAY_MERCHANT_ID=
# Mandatory for PRODUCTION (separate Google merchant ID, not the PAYONE ID):
VITE_GOOGLE_MERCHANT_ID=
VITE_GOOGLE_MERCHANT_NAME=PAYONE demo
VITE_GOOGLE_BUTTON_LOCALE=de
# PAYONE EU default. For an explicit desktop TEST, try PAN_ONLY,CRYPTOGRAM_3DS.
# PAN_ONLY support for actual payments must match your PAYONE integration.
VITE_GOOGLE_ALLOWED_AUTH_METHODS=CRYPTOGRAM_3DS
